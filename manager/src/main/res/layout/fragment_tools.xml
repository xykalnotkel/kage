<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tools_swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alat ini dijalankan dengan identitas server (shell / root). Semua aksi tercatat di log." />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tools_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tools_output"
            style="@style/Mono"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_terminal"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:textIsSelectable="true" />
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
