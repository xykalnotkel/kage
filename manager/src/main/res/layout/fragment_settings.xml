<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/kage_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/CardTitle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Perilaku server" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_debug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Debug log (verbose, --debug)" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_autostart_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tampilkan perintah start saat app dibuka" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_file_transport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pakai transport file (fallback) saja" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/kage_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/CardTitle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Info" />

                <TextView
                    android:id="@+id/settings_info"
                    style="@style/CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_about"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tentang Kage · lisensi &amp; dokumentasi" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_regenerate"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buat ulang token &amp; script" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
